<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchFilterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

    <!-- Menu button opens sidebar -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_sort_by_size"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Open menu"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Search by Filters"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/btnMenu"
        app:layout_constraintBottom_toBottomOf="@id/btnMenu"
        app:layout_constraintStart_toEndOf="@id/btnMenu"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Active Category -->
    <TextView
        android:id="@+id/tvActiveCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select a filter to begin"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Scrollable filter chips -->
    <HorizontalScrollView
        android:id="@+id/chipScroller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvActiveCategory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- FILTER LABELS FOR CHIPS -->

            <!-- University label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Universities"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="6dp"/>

            <Button
                android:id="@+id/chipTopUniversities"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Top Rated"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <Button
                android:id="@+id/chipLowUniversities"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Lowest Rated"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#FFFFFF"
                android:layout_marginEnd="16dp"/>

            <!-- Course label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Courses:"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/chipHighestOverall"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Best Overall"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <Button
                android:id="@+id/chipLowestOverall"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Worst Overall"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <Button
                android:id="@+id/chipEasiest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Easiest"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <Button
                android:id="@+id/chipHardest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Hardest"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <Button
                android:id="@+id/chipLightWorkload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Light Workload"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

            <Button
                android:id="@+id/chipHeavyWorkload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Heavy Workload"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:background="@drawable/chip_unselected"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Result count -->
    <TextView
        android:id="@+id/tvResultCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Select a filter to view results"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#666666"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/chipScroller"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnResetFilters"/>

    <!-- Reset Button -->
    <Button
        android:id="@+id/btnResetFilters"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Reset"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:minHeight="0dp"
        android:minWidth="0dp"
        app:layout_constraintTop_toTopOf="@id/tvResultCount"
        app:layout_constraintBottom_toBottomOf="@id/tvResultCount"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#FFFFFF"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvResultCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Results list -->
    <ListView
        android:id="@+id/lvFilterResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:divider="#FFFFFF"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_search_filter"
        app:menu="@menu/menu_search_filter_drawer"/>

</androidx.drawerlayout.widget.DrawerLayout>